---
import Placeholder from './Placeholder.astro';
---

<section id="about" class="bg-green-wash py-24 md:py-28 reveal">
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-5 gap-12 md:gap-16 items-center">
      <Placeholder
        tone="sage"
        class="relative w-full h-96 md:h-[36rem] rounded-media md:col-span-2"
      />

      <div class="md:col-span-3">
        <p class="text-sm font-semibold tracking-widest uppercase text-green mb-4">About</p>
        <h2 class="font-serif text-4xl md:text-6xl leading-[1.05] text-green-dark mb-8">Celeste</h2>

        <div class="space-y-5 text-body leading-relaxed max-w-xl">
          <p>
            Celeste spent the majority of her years as a dancer before finding Yoga. What began as a
            meditation practice to nurture her mind and overall wellbeing developed into a physical
            Yoga practice where she found, for the first time, the opportunity to turn inward while
            moving outward. From outward performance to inward presence.
          </p>
          <p>
            A trained Rocket<sup class="text-xs">™</sup>, Ashtanga and Vinyasa teacher, Celeste
            offers classes with an equal balance of energy and grounding stability — a chance to hit
            pause on the external world and tend to yourself. Expect body and breath awareness,
            mental and emotional resilience, and most importantly, a chance to play.
          </p>
        </div>

        <p class="font-serif text-2xl md:text-3xl text-green-dark mt-9">
          Come and be part of our wonderful community.
        </p>
      </div>
    </div>
  </div>
</section>
