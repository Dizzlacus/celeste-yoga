---
import { site } from '../data/site';

const fieldClass =
  'w-full px-5 py-4 bg-paper border border-border rounded-card text-ink placeholder-muted focus:outline-none focus:border-green transition-colors';
---

<section id="contact" class="bg-paper py-24 md:py-28 reveal">
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
      <div>
        <p class="text-sm font-semibold tracking-widest uppercase text-green mb-4">Contact</p>
        <h2 class="font-serif text-4xl md:text-6xl leading-[1.05] text-green-dark mb-6">
          Say hello
        </h2>
        <p class="text-body leading-relaxed max-w-md mb-8">
          Questions about a class, a workshop, or where to start? Send a message and I&rsquo;ll get
          back to you.
        </p>
        <p class="text-sm text-muted leading-relaxed max-w-md mb-8">
          Even yogis need a pause sometimes. I occasionally step away from Instagram to return to
          myself — thank you for understanding.
        </p>
        <a
          href={`mailto:${site.email}`}
          class="text-green underline underline-offset-4 hover:no-underline transition-all"
          >{site.email}</a
        >
      </div>

      <div>
        <div id="contact-form-block">
          <form
            id="contact-form"
            class="space-y-5"
            action="https://formspree.io/f/xnjllrza"
            method="POST"
          >
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class={fieldClass}
              placeholder="Name"
            />
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class={fieldClass}
              placeholder="Email"
            />
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class={`${fieldClass} resize-none`}
              placeholder="Your message..."></textarea>
            <div class="hidden" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button
              type="submit"
              class="rounded-full bg-green px-9 py-3.5 text-paper hover:bg-green-dark transition-colors"
            >
              Send message
            </button>
          </form>
        </div>

        <div id="contact-success" class="hidden py-12" role="status" aria-live="polite">
          <p class="font-serif text-3xl text-green-dark mb-3">Thank you for reaching out</p>
          <p class="text-body">I&rsquo;ll get back to you soon.</p>
        </div>
      </div>
    </div>
  </div>
</section>
