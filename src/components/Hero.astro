---
import Crescent from './Crescent.astro';
import { classSchedule, currentEvents, yogaStyles } from '../data/site';
import { getHeroImages } from '../utils/heroImages';
import { withBase } from '../utils/path';

const { avif, webp, fallback } = await getHeroImages();

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** Interior-page header: shorter panel, no stats bar and no calls to action,
   *  since interior pages lead straight into their own content. */
  compact?: boolean;
}

const {
  id = 'home',
  eyebrow = 'Yoga in Newcastle',
  title = 'Come as you are, do what you can.',
  intro = 'Rocket™, Ashtanga and Vinyasa with Celeste — an inclusive space to move, breathe and belong.',
  compact = false,
} = Astro.props;

const studios = new Set(
  classSchedule.flatMap((day) => day.classes.map((cls) => cls.name.split('@')[1]?.trim())).filter(Boolean)
);

const facts = [
  { value: String(studios.size), label: 'studios across Newcastle' },
  { value: String(yogaStyles.length), label: 'styles, all levels welcome' },
];
---

<section
  id={id}
  class:list={[
    'on-dark bg-green-deep pt-24 md:pt-28',
    compact ? 'pb-16 md:pb-20' : 'md:h-[100vh] md:max-h-[100vh] md:flex md:flex-col',
  ]}
>
  <div
    class:list={[
      'max-w-7xl mx-auto px-4 sm:px-6 md:px-8',
      !compact && 'md:flex-1 md:flex md:flex-col md:min-h-0 md:w-full',
    ]}
  >
    <div
      class:list={[
        'relative rounded-[1.75rem] md:rounded-[2.5rem] overflow-hidden flex items-center isolate bg-green',
        compact ? 'min-h-[36vh] md:min-h-[42vh]' : 'min-h-[62vh] md:flex-1 md:min-h-0',
      ]}
    >
      <div
        class="hidden md:block absolute inset-y-0 right-0 w-[58%]"
        aria-hidden="true"
      >
        <picture class="block w-full h-full">
          <source media="(min-width: 768px)" srcset={avif.src} type="image/avif" />
          <source media="(min-width: 768px)" srcset={webp.src} type="image/webp" />
          <source media="(min-width: 768px)" srcset={fallback.src} />
          <img
            src="data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA="
            alt=""
            width={fallback.attributes.width}
            height={fallback.attributes.height}
            class:list={[
              'hero-photo w-full h-full object-cover mix-blend-multiply contrast-105 brightness-125',
              compact ? 'object-[center_70%]' : 'object-[center_75%]',
            ]}
            decoding="sync"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>

      <Crescent class="absolute -right-[12%] -bottom-[18%] w-1/2 text-cream/10" />

      <div
        class="absolute inset-0 bg-gradient-to-r from-green-deep/90 via-green-deep/70 via-[40%] to-transparent"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 px-7 sm:px-10 md:px-16 py-14 md:py-20 max-w-2xl">
        <div class="flex items-center gap-3 mb-6">
          <Crescent bold class="w-6 text-orange shrink-0" />
          <p class="text-sm tracking-widest uppercase text-sage">{eyebrow}</p>
        </div>

        <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl leading-[1.02] text-cream mb-6">
          {title}
        </h1>

        <p
          class:list={[
            'text-base md:text-lg text-sage leading-relaxed max-w-md',
            !compact && 'mb-10',
          ]}
        >
          {intro}
        </p>

        {
          !compact && (
            <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
              <a
                href={withBase('/#classes')}
                class="inline-flex items-center gap-3 rounded-full bg-cream pl-7 pr-3 py-3 text-green-deep hover:bg-orange transition-colors"
              >
                See class times
                <span
                  class="flex items-center justify-center w-8 h-8 rounded-full bg-green-deep text-cream"
                  aria-hidden="true"
                >
                  <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
              {currentEvents.length > 0 && (
                <a
                  href={withBase('/events')}
                  class="text-cream underline underline-offset-4 hover:text-orange hover:no-underline transition-all"
                >
                  Upcoming events
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>

    {
      !compact && (
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-8 md:gap-16 py-12 md:py-14">
          {facts.map((fact) => (
            <div class="flex items-baseline gap-3">
              <span class="font-serif text-4xl md:text-5xl text-cream leading-none">
                {fact.value}
                <span class="text-orange">+</span>
              </span>
              <span class="text-sm text-sage leading-snug">{fact.label}</span>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
