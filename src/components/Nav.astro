---
import { featuredEvent } from '../data/site';
import { withBase } from '../utils/path';

interface Props {
  showMobileNav?: boolean;
  sticky?: boolean;
  homeLinks?: boolean;
}

const { showMobileNav = true, sticky = true, homeLinks = true } = Astro.props;

const links = homeLinks
  ? [
      { href: withBase('/#welcome'), label: 'Welcome' },
      { href: withBase('/#classes'), label: 'Classes' },
      ...(featuredEvent
        ? [{ href: withBase('/#community'), label: 'Community', startsOn: featuredEvent.startsOn }]
        : []),
      { href: withBase('/#about'), label: 'About' },
      { href: withBase('/events'), label: 'Events' },
    ]
  : [];
---

<nav
  class:list={[
    'on-dark bg-green-deep',
    sticky ? 'fixed top-0 left-0 right-0 z-50' : 'w-full',
  ]}
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-2.5 md:py-4">
    <div class="flex justify-between items-center gap-6">
      <a
        href={withBase('/#home')}
        class="inline-flex items-center hover:opacity-80 transition-opacity"
        aria-label="Alma Yoga home"
      >
        <img
          src={withBase('/logo.svg')}
          alt="Alma Yoga"
          width="152"
          height="118"
          class="h-10 md:h-14 w-auto"
        />
      </a>

      {
        homeLinks && (
          <div class="hidden md:flex items-center gap-8">
            {links.map((link) => (
              <a
                href={link.href}
                class="text-sm tracking-wide text-sage hover:text-cream transition-colors"
                data-starts-on={link.startsOn}
              >
                {link.label}
              </a>
            ))}
            <a
              href={withBase('/#contact')}
              class="rounded-full border border-sage/60 px-6 py-2.5 text-sm text-cream hover:bg-cream hover:text-green-deep hover:border-cream transition-colors"
            >
              Get in touch
            </a>
          </div>
        )
      }

      {
        showMobileNav && homeLinks && (
          <button
            id="nav-burger"
            class="md:hidden relative flex items-center justify-center w-10 h-10 text-cream"
            aria-expanded="false"
            aria-controls="nav-mobile-panel"
            aria-label="Toggle navigation menu"
          >
            <svg
              id="icon-hamburger"
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg
              id="icon-close"
              class="w-6 h-6 is-hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        )
      }
    </div>

    {
      showMobileNav && homeLinks && (
        <div id="nav-mobile-panel" class="md:hidden border-t border-sage/25" aria-hidden="true">
          <div class="pt-4 pb-2 flex flex-col gap-4">
            {links.map((link) => (
              <a
                href={link.href}
                class="text-sage hover:text-cream transition-colors text-left"
                data-starts-on={link.startsOn}
              >
                {link.label}
              </a>
            ))}
            <a href={withBase('/#contact')} class="text-orange hover:text-cream transition-colors text-left">
              Get in touch
            </a>
          </div>
        </div>
      )
    }
  </div>
</nav>
