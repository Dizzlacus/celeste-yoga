---
import Placeholder from './Placeholder.astro';
---

<section id="welcome" class="bg-green-wash py-24 md:py-28 reveal">
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-2 gap-10 md:gap-20 items-start mb-14 md:mb-20">
      <div>
        <p class="text-sm font-semibold tracking-widest uppercase text-green mb-4">Welcome</p>
        <h2 class="font-serif text-4xl md:text-6xl leading-[1.05] text-green-dark">
          A space to move, breathe and belong
        </h2>
      </div>
      <div class="space-y-5 text-body leading-relaxed md:pt-3">
        <p>
          Alma is led by Celeste, a dedicated Yoga teacher known for her passion of movement and
          wellbeing. Specialising in Rocket<sup class="text-xs">™</sup>, Ashtanga and Vinyasa,
          classes are created to be an inclusive space that invite you to come as you are and do
          what you can — recognising that each day, each body and each practice can be different.
        </p>
        <p>
          Our classes offer the opportunity to explore your physical potential, create mental
          spaciousness and develop a deeper connection to self.
        </p>
        <a
          href="/#about"
          class="inline-block rounded-full border border-green/40 px-7 py-3 text-green hover:bg-green hover:text-paper transition-colors mt-2"
        >
          Meet Celeste
        </a>
      </div>
    </div>

    <Placeholder class="relative w-full h-64 md:h-[26rem] rounded-media" />
  </div>
</section>
