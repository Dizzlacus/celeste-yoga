---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Placeholder from '../components/Placeholder.astro';
import { upcomingEvents } from '../data/site';
---

<BaseLayout
  title="Events — Alma"
  description="Workshops, retreats and community events with Celeste at Alma in Newcastle."
>
  <Hero
    id="events"
    eyebrow="What's coming up"
    title="Events, workshops and retreats"
    intro="Deeper practice, seasonal gatherings and space to meet the people you share the room with."
    compact
  />

  {
    upcomingEvents.map((event, index) => {
      const imageOnLeft = index % 2 === 1;
      const onWash = index % 2 === 1;

      return (
        <section class:list={['py-20 md:py-24 reveal', onWash ? 'bg-green-wash' : 'bg-paper']}>
          <div class="max-w-7xl mx-auto px-6 md:px-10">
            <div class="grid md:grid-cols-5 gap-12 md:gap-16 items-center">
              {imageOnLeft && (
                <Placeholder
                  tone={index % 3 === 1 ? 'sage' : 'green'}
                  class="relative w-full h-80 md:h-[30rem] rounded-media md:col-span-2"
                />
              )}

              <div class="md:col-span-3">
                <h2 class="font-serif text-4xl md:text-5xl leading-[1.05] text-green-dark mb-6">
                  {event.title}
                </h2>
                <div class="text-body leading-relaxed space-y-4 max-w-xl">
                  {event.description.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                <dl class="mt-8 space-y-3 border-t border-border pt-6 max-w-md">
                  <div class="flex flex-wrap gap-x-3">
                    <dt class="text-muted w-16 shrink-0">When</dt>
                    <dd class="text-ink">{event.date}</dd>
                  </div>
                  <div class="flex flex-wrap gap-x-3">
                    <dt class="text-muted w-16 shrink-0">Time</dt>
                    <dd class="text-ink">{event.time}</dd>
                  </div>
                  <div class="flex flex-wrap gap-x-3">
                    <dt class="text-muted w-16 shrink-0">Where</dt>
                    <dd class="text-ink">{event.location}</dd>
                  </div>
                  <div class="flex flex-wrap gap-x-3">
                    <dt class="text-muted w-16 shrink-0">Cost</dt>
                    <dd class="text-ink">{event.cost}</dd>
                  </div>
                </dl>

                <div class="pt-8">
                  <a
                    href={event.bookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block rounded-full bg-green px-9 py-3.5 text-paper hover:bg-green-dark transition-colors"
                  >
                    Book here
                  </a>
                </div>
              </div>

              {!imageOnLeft && (
                <Placeholder
                  tone={index % 3 === 0 ? 'green' : 'sage'}
                  class="relative w-full h-80 md:h-[30rem] rounded-media md:col-span-2"
                />
              )}
            </div>
          </div>
        </section>
      );
    })
  }
</BaseLayout>
