---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/path';

const lastUpdated = new Date().toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title="Privacy Policy — Alma"
  description="Privacy policy for the Alma yoga website."
  stickyNav={false}
>
  <main class="max-w-3xl mx-auto px-6 py-12 md:py-16">
    <h1 class="font-serif text-4xl md:text-5xl text-green-dark mb-6">Privacy Policy</h1>
    <p class="text-body leading-relaxed mb-4">
      This is a placeholder privacy policy for the Alma website. Replace this text with your own
      policy describing how you collect, use, and protect personal information (including contact
      form submissions and analytics, if applicable).
    </p>
    <p class="text-body leading-relaxed mb-4">
      Last updated: {lastUpdated}
    </p>
    <div class="mt-10 pt-8 border-t border-border">
      <a href={withBase('/')} class="text-sm text-green hover:text-green-dark transition-colors">Back to home</a
      >
    </div>
  </main>
</BaseLayout>
