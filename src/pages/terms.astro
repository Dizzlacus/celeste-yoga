---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = new Date().toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title="Terms of Use — Alma"
  description="Terms of use for the Alma yoga website."
  stickyNav={false}
>
  <main class="max-w-3xl mx-auto px-6 py-12 md:py-16">
    <h1 class="font-serif text-4xl md:text-5xl text-green-dark mb-6">Terms of Use</h1>
    <p class="text-body leading-relaxed mb-4">
      This is a placeholder terms of use page for the Alma website. Replace this text with your own
      terms covering use of the site, class bookings, liability, and any other legal points relevant
      to your practice.
    </p>
    <p class="text-body leading-relaxed mb-4">
      Last updated: {lastUpdated}
    </p>
    <div class="mt-10 pt-8 border-t border-border">
      <a href="/" class="text-sm text-green hover:text-green-dark transition-colors">Back to home</a
      >
    </div>
  </main>
</BaseLayout>
